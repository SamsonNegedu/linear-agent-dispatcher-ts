{
  "name": "linear-dispatcher-monorepo",
  "version": "0.1.0",
  "description": "Linear webhook dispatcher: a local relay receives Linear webhooks and fans them out to local dispatchers that run Claude",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "relay": "cd services/relay-service && pnpm dev",
    "dispatcher": "cd services/dispatcher-service && pnpm dev",
    "routes": "pnpm --dir services/dispatcher-service routes",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev:up": "node scripts/dev-up.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}

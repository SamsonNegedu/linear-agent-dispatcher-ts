# Dispatcher Service Environment Configuration
# Copy this file to .env.local and update values for your environment

# Server Configuration
PORT=3000
NODE_ENV=development

# Relay Webhook Configuration
# HMAC-SHA256 secret for verifying relay → dispatcher webhooks
# Must match the relay service's DISPATCHER_SUBSCRIBER_SECRET
RELAY_SUBSCRIBER_SECRET=your-relay-subscriber-secret-here

# Claude Executor Configuration
# Path to claude binary (can be absolute path or command name if in PATH)
CLAUDE_BIN_PATH=claude

# Permission mode for claude CLI: 'auto' or 'ask'
# 'auto' = grant permissions automatically, 'ask' = prompt user
# Leave unset to disable permission mode flag
CLAUDE_PERMISSION_MODE=auto

# Dispatcher Database Configuration
# SQLite database path (per-engineer, not shared)
# Relative paths are relative to cwd where dispatcher service runs
DISPATCHER_DB_PATH=./data/dispatcher.db

# Repository Configuration
# Default working directory where handler processes execute
# Can be overridden per-issue via Linear labels (see REPO_MAPPING)
DISPATCHER_REPO_PATH=.

# Repository and Skill Configuration
# Repos and modes are configured in repos.config.json (checked into git)
# Domain labels (e.g., "backend", "frontend") route issues to repo paths
# Mode labels (e.g., "agent-implement", "agent-plan") select which Claude skill to invoke
# Each repo in repos.config.json must define its available modes (mode label → skill name)
# Example: Issue with labels "backend" + "agent-implement" runs /linear-implement in ./services/backend
# Each repo must have .claude/settings.json with available skills

# Execution Configuration
# Maximum duration for a single claude run (ms)
# Default: 30 minutes
MAX_RUN_DURATION=1800000

# Linear Integration Configuration
# API key for posting agent session activities to Linear
# Required for activity feedback (run start, completion, errors, input requests)
# Obtain from: https://linear.app/settings/api
# Scope required: activities:create (minimal scope for activity posting only)
# If not set, activity posting is silently skipped (runs still execute normally)
LINEAR_API_KEY=your-linear-api-key-here

# GraphQL Label Fallback
# Linear webhooks may not include complete label set on issue
# Enable GraphQL fallback to fetch labels if webhook has fewer than threshold
# Default: true (enabled)
LINEAR_LABEL_FALLBACK=true

# Minimum label count before triggering GraphQL fallback
# If webhook has fewer labels than this, fetch complete set via GraphQL
# Default: 2 (fetch if webhook has 0-1 labels, trust if 2+)
LINEAR_MIN_LABELS=2

{
  "name": "@dispatcher/core",
  "version": "0.1.0",
  "description": "NestJS webhook dispatcher: routes issues to Claude, supports relay or standalone mode",
  "main": "dist/services/dispatcher-service/src/main.js",
  "scripts": {
    "postinstall": "test -f routing.config.json || cp routing.config.example.json routing.config.json",
    "dev": "tsc && node dist/services/dispatcher-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",
    "server:dev": "tsc && node dist/services/dispatcher-service/src/main.js",
    "build": "tsc",
    "start": "node dist/services/dispatcher-service/src/main.js",
    "monitor": "pnpm --filter @dispatcher/core build && node scripts/monitor.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "connect-relay": "tsc && node dist/services/dispatcher-service/src/cli/connect-relay.js",
    "update-relay": "tsc && node dist/services/dispatcher-service/src/cli/update-relay.js",
    "test-webhook": "tsc && node dist/services/dispatcher-service/src/cli/test-webhook.js",
    "routes": "tsc && node dist/services/dispatcher-service/src/cli/routes.js"
  },
  "dependencies": {
    "@linear-agent/env-file": "workspace:*",
    "@linear-agent/linear-client": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "@webhook-verify/core": "workspace:*",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "typescript": "7.0.2"
  }
}

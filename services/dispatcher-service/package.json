{
  "name": "@dispatcher/core",
  "version": "0.1.0",
  "description": "NestJS webhook dispatcher: routes issues to Claude, supports relay or standalone mode",
  "main": "dist/services/dispatcher-service/src/main.js",
  "scripts": {
    "postinstall": "test -f routing.config.json || cp routing.config.example.json routing.config.json",
    "dev": "tsc && node dist/services/dispatcher-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",
    "server:dev": "ts-node src/main.ts",
    "build": "tsc",
    "start": "node dist/services/dispatcher-service/src/main.js",
    "monitor": "pnpm --filter @dispatcher/core build && node scripts/monitor.js",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "connect-relay": "ts-node src/cli/connect-relay.ts",
    "update-relay": "ts-node src/cli/update-relay.ts",
    "test-webhook": "ts-node src/cli/test-webhook.ts",
    "routes": "ts-node src/cli/routes.ts"
  },
  "dependencies": {
    "@linear-agent/env-file": "workspace:*",
    "@linear-agent/linear-client": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@webhook-verify/core": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "nestjs-pino": "^4.6.0",
    "pg": "^8.11.3",
    "pino": "^8.17.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.19",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.0.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}

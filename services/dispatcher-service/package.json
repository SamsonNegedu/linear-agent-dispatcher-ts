{
  "name": "@dispatcher/core",
  "version": "0.1.0",
  "description": "NestJS webhook dispatcher: routes issues to Claude, supports relay or standalone mode",
  "main": "dist/services/dispatcher-service/src/main.js",
  "scripts": {
    "postinstall": "test -f repos.config.json || cp repos.config.example.json repos.config.json",
    "dev": "tsc && node dist/services/dispatcher-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",
    "build": "tsc",
    "start": "node dist/services/dispatcher-service/src/main.js",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "connect-relay": "ts-node src/cli/connect-relay.ts",
    "test-webhook": "ts-node src/cli/test-webhook.ts"
  },
  "dependencies": {
    "@linear-agent/linear-client": "workspace:*",
    "@api-gateway/serverless-express": "workspace:*",
    "@webhook-verify/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "typeorm": "^0.3.19",
    "better-sqlite3": "^12.11.1",
    "pg": "^8.11.3",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "js-yaml": "^4.1.0",
    "pino": "^8.17.0",
    "nestjs-pino": "^4.6.0",
    "uuid": "^9.0.0",
    "graphql-request": "^6.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.0",
    "@types/express": "^4.17.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "properties": {
        "skipDoneIssues": {
          "type": "boolean"
        },
        "duplicateRunWindowMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "description": "Skill names that the label agent-<name> may run"
    },
    "repositories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "description": "Skill names that the label agent-<name> may run"
              },
              "issueLabelToSkill": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+(:[a-zA-Z0-9_-]+)?$"
                }
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["repositories"],
  "additionalProperties": false
}

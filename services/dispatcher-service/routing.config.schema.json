{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "_comment": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "properties": {
        "skipDoneIssues": {
          "type": "boolean"
        },
        "duplicateRunWindowMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "scanner": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "intervalSec": {
          "default": 60,
          "type": "integer",
          "minimum": 10,
          "maximum": 9007199254740991
        },
        "scopes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "team": {
                "description": "Team key, e.g. \"DLAI\"",
                "type": "string",
                "minLength": 1
              },
              "project": {
                "description": "Linear project id",
                "type": "string",
                "minLength": 1
              },
              "watch": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-zA-Z0-9_-]+$"
                    },
                    "states": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": ["label", "states"],
                  "additionalProperties": false
                }
              },
              "maxConcurrent": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "maxAttempts": {
                "default": 3,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": ["watch", "maxConcurrent", "maxAttempts"],
            "additionalProperties": false
          }
        }
      },
      "required": ["enabled", "intervalSec", "scopes"],
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "description": "Skill names that the label agent-<name> may run"
    },
    "repositories": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "skills": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "description": "Skill names that the label agent-<name> may run"
              },
              "issueLabelToSkill": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+(:[a-zA-Z0-9_-]+)?$"
                }
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["repositories"],
  "additionalProperties": false
}

{
  "name": "@relay/service",
  "version": "0.1.0",
  "description": "Webhook relay: receives from Linear, fans out to subscribers via HTTP",
  "main": "dist/services/relay-service/src/main.js",
  "scripts": {
    "dev": "tsc && node dist/services/relay-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",

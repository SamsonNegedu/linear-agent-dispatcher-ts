{
  "name": "@relay/service",
  "version": "0.1.0",
  "description": "Webhook relay: receives from Linear, fans out to subscribers via HTTP",
  "main": "dist/services/relay-service/src/main.js",
  "scripts": {
    "dev": "tsc && node dist/services/relay-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",
    "build": "tsc",
    "start": "node dist/services/relay-service/src/main.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "exports": {
    ".": "./dist/services/relay-service/src/main.js"
  },
  "dependencies": {
    "@linear-agent/env-file": "workspace:*",
    "@linear-agent/linear-client": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "@webhook-verify/core": "workspace:*",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "typescript": "7.0.2"
  }
}

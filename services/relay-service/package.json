    "start": "node dist/services/relay-service/src/main.js",
    "test": "jest"
  },
  "exports": {
    ".": "./dist/services/relay-service/src/main.js"
  },
  "dependencies": {
    "@linear-agent/env-file": "workspace:*",
    "@linear-agent/linear-client": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@webhook-verify/core": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.0",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.7.0"
  }
}

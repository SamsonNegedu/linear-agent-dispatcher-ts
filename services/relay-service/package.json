{
  "name": "@relay/service",
  "version": "0.1.0",
  "description": "Webhook relay: receives from Linear, fans out to subscribers via HTTP",
  "main": "dist/services/relay-service/src/main.js",
  "scripts": {
    "dev": "tsc && node dist/services/relay-service/src/main.js",
    "dev:watch": "nodemon --watch src --ext ts --exec 'pnpm dev'",
    "build": "tsc",
    "start": "node dist/services/relay-service/src/main.js",
    "test": "jest"
  },
  "exports": {
    ".": "./dist/services/relay-service/src/main.js"
  },
  "dependencies": {
    "@linear-agent/linear-client": "workspace:*",
    "@webhook-verify/core": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.10.0",
    "reflect-metadata": "^0.2.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.7.0",
    "@types/better-sqlite3": "^7.6.11"
  }
}

# Linear OAuth & Webhooks
# Get these from your Linear workspace settings
LINEAR_OAUTH_CLIENT_ID=your_linear_oauth_client_id
LINEAR_OAUTH_CLIENT_SECRET=your_linear_oauth_client_secret
LINEAR_WEBHOOK_SECRET=your_linear_webhook_secret

# Relay base URL, used to build OAuth callback/redirect URLs
# Optional: set only if not running pnpm connect-relay (e.g. for team deployments).
# When using pnpm connect-relay, pass --relay-url instead and this is not needed.
# RELAY_BASE_URL=http://localhost:3001

# AWS Region (optional - defaults to us-east-1)
# Not needed when running via `sst dev`
# AWS_REGION=us-east-1

# DynamoDB (optional - only needed for local testing without sst)
# When running via `sst dev`, these are not needed
# DYNAMODB_ENDPOINT=http://localhost:8000
# DYNAMODB_REGION=us-east-1

# Tunnel for `pnpm dev:up`. Default: Tailscale Funnel if tailscale is running, else a random trycloudflare.com URL.
# Set both below to force a Cloudflare named tunnel instead (needs a domain).
# Create a tunnel in Cloudflare Zero Trust, route TUNNEL_HOSTNAME -> http://host.docker.internal:<relay-port>
# CLOUDFLARE_TUNNEL_TOKEN=
# TUNNEL_HOSTNAME=relay.example.com

# Unattended Claude runs cannot answer permission prompts, so anything not allowed is denied.
# Defaults: core tools below + every MCP server configured for the repo (found via `claude mcp list`),
# permission mode dontAsk. A repo's own .claude/settings.json (allow AND deny rules) still applies.
# CLAUDE_ALLOWED_TOOLS=Read,Edit,Write,Glob,Grep,Bash,Skill,Task,TodoWrite,NotebookEdit
# CLAUDE_ALLOW_ALL_MCP=true         # set false to allow only the tools listed above
# CLAUDE_PERMISSION_MODE=dontAsk

{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "noEmitOnError": false,
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@webhook-verify/core": ["packages/webhook-verify/src"],
      "@webhook-verify/core/*": ["packages/webhook-verify/src/*"],
      "@linear-agent/env-file": ["packages/env-file/src"],
      "@linear-agent/linear-client": ["packages/linear-client/src"],
      "@linear-agent/linear-client/*": ["packages/linear-client/src/*"],
      "@dispatcher/*": ["services/dispatcher-service/src/*"],
      "@relay/*": ["services/relay-service/src/*"]
    }
  },
  "include": ["packages/*/src", "services/*/src"],
  "exclude": ["node_modules", "dist"]
}

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": { "entry": ["scripts/*.mjs"] },
    "packages/*": { "entry": ["src/**/*.spec.ts"] },
    "services/dispatcher-service": {
      "entry": ["src/cli/*.ts", "src/**/*.spec.ts", "scripts/*.js"]
    },
    "services/relay-service": { "entry": ["src/main.ts", "src/**/*.spec.ts"] }
  },
  "ignoreExportsUsedInFile": true
}
